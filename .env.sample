# ─────────────────────────────────────────────
# MDMS URL Migration — Environment Configuration
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Auth token from your DIGIT login session
AUTH_TOKEN=your_auth_token_here

# Tenant ID
TENANT_ID=chad

# Comma-separated list of schema codes to migrate
SCHEMA_CODES=ACCESSCONTROL-ACTIONS-TEST.actions-test

# URL replacement config
OLD_URL=/workbench-ui/employee
NEW_URL=/chad/hcm-digit-ui/employee

# Max records to fetch per search call
LIMIT=100000

# Set to true to preview changes without calling update API
DRY_RUN=false

# Number of parallel update calls per batch
BATCH_SIZE=10

# Retry settings for failed API calls
RETRY_ATTEMPTS=3
RETRY_DELAY_MS=1000

# Directories
BACKUP_DIR=./backups
REPORTS_DIR=./reports
LOG_DIR=./logs

# Log level: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# ─────────────────────────────────────────────
# Port-Forward Configuration (kubectl)
# ─────────────────────────────────────────────

# Namespace where mdms-v2 service is deployed
K8S_NAMESPACE=egov

# Kubernetes service name for mdms-v2
K8S_SERVICE=mdms-v2

# Remote port of the mdms-v2 service inside the cluster
K8S_REMOTE_PORT=8080

# Local port to bind the port-forward on
K8S_LOCAL_PORT=8081

# Set to true to use kubectl port-forward instead of BASE_URL
USE_PORT_FORWARD=true

# Only used if USE_PORT_FORWARD=false
BASE_URL=https://campaigns.afro.who.int
